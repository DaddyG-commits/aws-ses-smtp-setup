# Required: the verified sender address in SES
SES_FROM_EMAIL=noreply@yourdomain.com

# Option 1 – AWS SDK (recommended for Vercel)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# Option 2 – SMTP (fallback if you prefer SMTP credentials)
# SES_SMTP_USER=...
# SES_SMTP_PASS=...
# SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
